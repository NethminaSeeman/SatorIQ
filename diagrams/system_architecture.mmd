flowchart TD
    user[User]
    streamlit[Streamlit Web Interface]
    router[Router / Planner Agent]
    retriever[Retriever Agent - RAG Search]
    chromadb[(Chroma Vector Database)]
    chunks[Retrieved Chunks]
    summary[Summary Agent]
    analysis[Analysis Agent]
    reflection[Reflection Agent]
    response[Final Response]

    user --> streamlit
    streamlit --> router
    router --> retriever
    retriever --> chromadb
    chromadb --> chunks
    chunks --> summary
    chunks --> analysis
    summary --> reflection
    analysis --> reflection
    reflection -->|approved| response
    reflection -->|"retry max 2"| analysis
    response --> streamlit
    streamlit --> user
