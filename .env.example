# SatorIQ Environment Variables

# Groq API Key (Used for Router, Summary, and Reflection Agents)
GROQ_API_KEY="your_groq_api_key_here"

# OpenRouter API Key (Used for Analysis Agent)
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# Optional: Add any other configurations like log levels or debugging
LOG_LEVEL="INFO"
